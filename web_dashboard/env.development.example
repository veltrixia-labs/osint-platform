# Local Pro/Expert UI unlock (copy to repo root `.env` or `web_dashboard/.env.development`).
# Vite merges VITE_* from the repo root and web_dashboard/ (see vite.config.ts).

# Frontend: unauthenticated dev user on localhost (main.ts buildDevOverrideUser)
VITE_DEV_TIER=pro
# VITE_DEV_TIER=experts

# Backend: tier gating for /api/insights/* without login (api/gating.py)
# Set in repo root `.env` alongside the frontend vars:
# ALLOW_DEV_TIER_OVERRIDE=true
# LOCAL_DEV_TIER=pro
# ENV=development
